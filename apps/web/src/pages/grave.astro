---
import Layout from '../layouts/Layout.astro';
import { DashboardApp } from '../components/dashboard/DashboardApp.tsx';

const description =
  'Bury ETH in the Grave, sell $NETH to the Reaper, and watch era and auction state on Base.';
---

<Layout title="Grave — Nether" description={description}>
  <main>
    <h1 class="sr-only">Nether Grave</h1>
    <DashboardApp client:load />
  </main>
</Layout>
