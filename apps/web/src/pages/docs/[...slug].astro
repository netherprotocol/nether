---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { displayTitle, docIdToSlug, firstHeading, groupDocs } from '../../lib/docs';
import { SITE_DESCRIPTION, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.flatMap((entry) => {
    const slug = docIdToSlug(entry.id);
    if (!slug) {
      return [];
    }
    return [{ params: { slug }, props: { entry } }];
  });
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = firstHeading(entry.body) ?? entry.id;
const all = await getCollection('docs');
const groups = groupDocs(all);

function hrefFor(id: string): string {
  const slug = docIdToSlug(id);
  return slug ? withBase(`docs/${slug}`) : withBase('docs');
}
---

<Layout title={`${title} — Nether`} description={SITE_DESCRIPTION}>
  <main class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-12 md:grid-cols-[14rem_minmax(0,1fr)] md:px-10 md:py-16">
    <aside class="text-sm">
      <a href={withBase('docs')} class="text-[0.7rem] tracking-[0.22em] text-muted uppercase">
        Documentation
      </a>
      {
        groups.map((group) => (
          <section class="mt-6">
            <h2 class="text-[0.65rem] tracking-[0.2em] text-muted uppercase">{group.label}</h2>
            <ul class="mt-2 space-y-1.5">
              {group.entries.map((item) => (
                <li>
                  <a
                    href={hrefFor(item.id)}
                    aria-current={item.id === entry.id ? 'page' : undefined}
                    class:list={[
                      'block text-[0.85rem] leading-snug',
                      item.id === entry.id ? 'text-white' : 'text-paper/70 hover:text-white',
                    ]}
                  >
                    {displayTitle(item.id, item.body)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </aside>
    <article class="doc-body min-w-0">
      <Content />
    </article>
  </main>
</Layout>
