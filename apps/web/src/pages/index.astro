---
import Layout from '../layouts/Layout.astro';
import FeatureIcon from '../components/FeatureIcons.astro';
import {
  APP_LATER_TITLE,
  FEATURES,
  HOLDER_COPY,
  HOLDER_KICKER,
  PRIMARY_CTA,
  SECONDARY_CTA,
  SITE_DESCRIPTION,
  SITE_TITLE,
  STATS,
  withBase,
} from '../lib/site';

const docsHref = withBase('docs');
const heroSrc = withBase('hero.png');
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} surface="holder">
  <main class="flex min-h-[calc(100svh-4.5rem)] flex-col">
    <section
      class="relative grid flex-1 items-center gap-6 px-6 pt-2 pb-4 md:grid-cols-[minmax(0,1fr)_minmax(16rem,26rem)] md:gap-4 md:px-16 md:pt-0 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,32rem)]"
    >
      <div class="relative z-10 max-w-xl">
        <h1 class="font-display text-[4rem] leading-none text-white md:text-[5.5rem] lg:text-8xl">
          {SITE_TITLE}
        </h1>
        <p
          class="mt-5 text-[0.72rem] font-medium tracking-[0.28em] text-accent uppercase md:text-[0.78rem]"
        >
          {HOLDER_KICKER}
        </p>
        <p class="mt-4 max-w-md text-[0.92rem] leading-relaxed font-light text-paper">
          {HOLDER_COPY}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <button
            type="button"
            disabled
            aria-disabled="true"
            title={APP_LATER_TITLE}
            class="bg-accent cursor-not-allowed px-5 py-3 text-[0.7rem] tracking-[0.22em] text-white uppercase"
          >
            {PRIMARY_CTA}
          </button>
          <a
            href={docsHref}
            class="border border-white/85 px-5 py-3 text-[0.7rem] tracking-[0.22em] text-white uppercase"
          >
            {SECONDARY_CTA}
          </a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md md:max-w-none">
        <img
          src={heroSrc}
          alt=""
          width="1122"
          height="1402"
          class="relative z-10 mx-auto block h-auto w-full max-h-[min(34rem,52svh)] object-contain"
        />
      </div>
    </section>

    <section
      class="grid gap-8 px-6 py-5 md:grid-cols-4 md:gap-8 md:px-16 md:py-4"
      aria-label="Protocol"
    >
      {
        FEATURES.map((feature) => (
          <article>
            <FeatureIcon name={feature.icon} />
            <h2 class="mt-4 text-[0.7rem] tracking-[0.22em] text-accent uppercase">{feature.title}</h2>
            <p class="mt-2 text-[0.82rem] leading-relaxed font-light text-paper/90">{feature.body}</p>
          </article>
        ))
      }
    </section>

    <section
      class="mt-auto flex flex-col border-t border-white/10 bg-[#0b0b0b] md:flex-row md:items-stretch"
      aria-label="Protocol facts"
    >
      {
        STATS.map((stat) => (
          <div class="flex-1 border-b border-white/10 px-5 py-4 md:border-r md:border-b-0 md:last:border-r-0 md:px-8 md:py-5">
            <p class="text-[0.62rem] tracking-[0.22em] text-accent uppercase">{stat.label}</p>
            <p class="mt-1.5 text-sm font-light text-white md:text-[0.95rem]">{stat.value}</p>
            {stat.detail ? (
              <p class="mt-0.5 text-[0.75rem] font-light text-paper/65">{stat.detail}</p>
            ) : null}
          </div>
        ))
      }
    </section>
  </main>
</Layout>
