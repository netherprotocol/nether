---
import Layout from '../layouts/Layout.astro';
import FeatureIcon from '../components/FeatureIcons.astro';
import GraveCta from '../components/GraveCta.astro';
import { HolderStats } from '../components/HolderStats.tsx';
import RiskWarning from '../components/RiskWarning.astro';
import {
  FEATURES,
  HOLDER_COPY,
  HOLDER_KICKER,
  SECONDARY_CTA,
  SITE_DESCRIPTION,
  SITE_TITLE,
  withBase,
} from '../lib/site';

const docsHref = withBase('docs');
const heroSrc = withBase('hero.png');
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} surface="holder">
  <main class="flex min-h-[calc(100svh-4.5rem)] flex-col md:min-h-0 md:flex-1">
    <section
      class="relative grid min-h-0 flex-1 items-center gap-4 px-6 pt-2 pb-2 md:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] md:items-stretch md:gap-2 md:px-12 md:pt-0 lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] lg:px-16"
    >
      <div class="relative z-10 max-w-xl self-center">
        <h1 class="font-display text-[3.5rem] leading-none text-white md:text-[4.75rem] lg:text-7xl">
          {SITE_TITLE}
        </h1>
        <p
          class="mt-4 text-[0.72rem] font-medium tracking-[0.28em] text-accent uppercase md:text-[0.78rem]"
        >
          {HOLDER_KICKER}
        </p>
        <p class="mt-3 max-w-md text-[0.92rem] leading-relaxed font-light text-paper">
          {HOLDER_COPY}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <GraveCta />
          <a
            href={docsHref}
            class="border border-white/85 px-5 py-3 text-[0.7rem] tracking-[0.22em] text-white uppercase"
          >
            {SECONDARY_CTA}
          </a>
        </div>
        <div class="mt-4">
          <RiskWarning />
        </div>
      </div>
      <div class="hero-mark relative mx-auto hidden min-h-0 w-full md:mx-0 md:block md:h-full">
        <img
          src={heroSrc}
          alt=""
          width="1122"
          height="1402"
          class="relative z-10 mx-auto block h-auto w-full object-contain md:absolute md:inset-0 md:h-full md:w-full"
        />
      </div>
    </section>

    <section
      class="grid shrink-0 gap-6 px-6 py-3 md:grid-cols-4 md:gap-8 md:px-16 md:py-3"
      aria-label="Protocol"
    >
      {
        FEATURES.map((feature) => (
          <article>
            <FeatureIcon name={feature.icon} />
            <h2 class="mt-2.5 text-[0.7rem] tracking-[0.22em] text-accent uppercase">{feature.title}</h2>
            <p class="mt-1.5 text-[0.8rem] leading-relaxed font-light text-paper/90">{feature.body}</p>
          </article>
        ))
      }
    </section>

    <HolderStats client:load />
  </main>
</Layout>
