---
import Layout from '../layouts/Layout.astro';
import { HOLDER_COPY, SITE_DESCRIPTION, SITE_TITLE, withBase } from '../lib/site';

const docsHref = withBase('docs');
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="flex min-h-[calc(100svh-4.5rem)] flex-col justify-end px-6 pb-16 md:px-16 md:pb-24">
    <div class="max-w-xl">
      <h1 class="font-display text-6xl text-white md:text-7xl">{SITE_TITLE}</h1>
      <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed font-light text-paper">
        {HOLDER_COPY}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <button
          type="button"
          disabled
          aria-disabled="true"
          title="The app ships in a later W7 NIP"
          class="bg-accent cursor-not-allowed px-5 py-3 text-[0.7rem] tracking-[0.22em] text-white uppercase disabled:opacity-100"
        >
          Enter the Grave
        </button>
        <a
          href={docsHref}
          class="border border-accent px-5 py-3 text-[0.7rem] tracking-[0.22em] text-white uppercase"
        >
          Documentation
        </a>
      </div>
    </div>
  </main>
</Layout>
