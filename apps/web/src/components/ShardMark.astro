---
function mulberry32(seed: number) {
  return () => {
    let t = (seed += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(0x4e657468);
const particles = Array.from({ length: 96 }, () => {
  const angle = rand() * Math.PI * 2;
  const radius = 22 + rand() * 168;
  return {
    x: 260 + Math.cos(angle) * radius,
    y: 528 + Math.sin(angle) * (8 + rand() * 22) + rand() * 6,
    r: 0.35 + rand() * 1.4,
    o: 0.1 + rand() * 0.48,
    copper: rand() > 0.7,
  };
});
---

<div class="shard-stage" aria-hidden="true">
  <svg class="shard-svg" viewBox="40 8 440 560" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="underglow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f0b090" stop-opacity="0.95"></stop>
        <stop offset="28%" stop-color="#c56a45" stop-opacity="0.55"></stop>
        <stop offset="62%" stop-color="#8a3d28" stop-opacity="0.16"></stop>
        <stop offset="100%" stop-color="#000" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="ground" cx="50%" cy="40%" r="55%">
        <stop offset="0%" stop-color="#2a1812" stop-opacity="0.9"></stop>
        <stop offset="55%" stop-color="#0a0807" stop-opacity="0.35"></stop>
        <stop offset="100%" stop-color="#000" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="faceUL" x1="150" y1="40" x2="260" y2="250" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#2c2622"></stop>
        <stop offset="100%" stop-color="#0b0908"></stop>
      </linearGradient>
      <linearGradient id="faceUR" x1="370" y1="30" x2="260" y2="250" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#3d342e"></stop>
        <stop offset="100%" stop-color="#12100e"></stop>
      </linearGradient>
      <linearGradient id="faceLL" x1="170" y1="500" x2="260" y2="250" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#b05e3e"></stop>
        <stop offset="42%" stop-color="#5c3022"></stop>
        <stop offset="100%" stop-color="#160e0b"></stop>
      </linearGradient>
      <linearGradient id="faceLR" x1="350" y1="520" x2="260" y2="230" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#e09268"></stop>
        <stop offset="36%" stop-color="#8a4a32"></stop>
        <stop offset="100%" stop-color="#1c120e"></stop>
      </linearGradient>
      <linearGradient id="edge" x1="260" y1="20" x2="260" y2="530" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#6a5e54" stop-opacity="0.3"></stop>
        <stop offset="70%" stop-color="#e0a07a" stop-opacity="0.85"></stop>
        <stop offset="100%" stop-color="#ffc8a0" stop-opacity="1"></stop>
      </linearGradient>
      <linearGradient id="reflectFade" x1="0" y1="532" x2="0" y2="568" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.28"></stop>
        <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <filter id="glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="16" result="b"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
      <filter id="soft">
        <feGaussianBlur stdDeviation="20"></feGaussianBlur>
      </filter>
      <mask id="reflectMask">
        <rect x="0" y="532" width="520" height="40" fill="url(#reflectFade)"></rect>
      </mask>
    </defs>

    <ellipse cx="260" cy="536" rx="200" ry="46" fill="url(#ground)"></ellipse>
    <ellipse class="shard-pulse" cx="260" cy="528" rx="148" ry="30" fill="url(#underglow)" filter="url(#soft)"
    ></ellipse>
    <ellipse cx="260" cy="526" rx="58" ry="8" fill="#f0b090" opacity="0.55" filter="url(#glow)"></ellipse>

    {
      Array.from({ length: 12 }, (_, i) => {
        const t = (i - 5.5) / 5.5;
        const y = 504 + Math.abs(t) * 16;
        const half = 176 - Math.abs(t) * 58;
        return (
          <line
            x1={260 - half}
            y1={y}
            x2={260 + half}
            y2={y}
            stroke="#c4785a"
            stroke-opacity={0.045 + (1 - Math.abs(t)) * 0.06}
          />
        );
      })
    }

    {particles.map((p) => (
      <circle
        cx={p.x}
        cy={p.y}
        r={p.r}
        fill={p.copper ? '#d49274' : '#f4efe6'}
        opacity={p.o}
      />
    ))}

    <g mask="url(#reflectMask)" opacity="0.32" transform="translate(0 1060) scale(1 -1)">
      <path d="M260 28 L128 232 L260 232 Z" fill="#2a201c"></path>
      <path d="M260 28 L392 232 L260 232 Z" fill="#3a2c26"></path>
      <path d="M128 232 L260 524 L260 232 Z" fill="#8a4a32"></path>
      <path d="M392 232 L260 524 L260 232 Z" fill="#c07852"></path>
    </g>

    <g class="shard-body">
      <path d="M260 28 L128 232 L208 232 L260 158 Z" fill="url(#faceUL)"></path>
      <path d="M260 28 L392 232 L312 232 L260 158 Z" fill="url(#faceUR)"></path>
      <path d="M128 232 L260 524 L260 318 L208 232 Z" fill="url(#faceLL)"></path>
      <path d="M392 232 L260 524 L260 318 L312 232 Z" fill="url(#faceLR)"></path>
      <path d="M260 158 L312 232 L260 318 L208 232 Z" fill="#050303"></path>
      <path d="M260 158 L208 232 L260 176 L312 232 Z" fill="#c07852" opacity="0.28"></path>
      <path d="M208 232 L260 318 L252 236 Z" fill="#6a3828" opacity="0.55"></path>
      <path d="M312 232 L260 318 L268 236 Z" fill="#e09a74" opacity="0.35"></path>
      <path
        d="M260 28 L128 232 L260 524 L392 232 Z"
        stroke="url(#edge)"
        stroke-width="1.1"
        opacity="0.55"
      ></path>
      <path
        d="M260 158 L312 232 L260 318 L208 232 Z"
        stroke="#e8b090"
        stroke-width="1"
        opacity="0.45"
      ></path>
      <path d="M260 28 L260 158" stroke="#d8c8bc" stroke-width="0.7" opacity="0.28"></path>
      <path d="M260 318 L260 524" stroke="#ffd0b0" stroke-width="1.1" opacity="0.55"></path>
    </g>
  </svg>
</div>
