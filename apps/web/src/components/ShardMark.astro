---
function mulberry32(seed: number) {
  return () => {
    let t = (seed += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(0x4e657468);
const particles = Array.from({ length: 110 }, () => {
  const angle = rand() * Math.PI * 2;
  const radius = 28 + rand() * 210;
  return {
    x: 260 + Math.cos(angle) * radius,
    y: 552 + Math.sin(angle) * (10 + rand() * 26) + rand() * 8,
    r: 0.35 + rand() * 1.55,
    o: 0.1 + rand() * 0.5,
    copper: rand() > 0.72,
  };
});
---

<div class="shard-stage" aria-hidden="true">
  <svg class="shard-svg" viewBox="0 0 520 640" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="underglow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#e8a078" stop-opacity="0.95"></stop>
        <stop offset="28%" stop-color="#c56a45" stop-opacity="0.55"></stop>
        <stop offset="62%" stop-color="#8a3d28" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="#000" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="ground" cx="50%" cy="40%" r="55%">
        <stop offset="0%" stop-color="#2a1812" stop-opacity="0.9"></stop>
        <stop offset="55%" stop-color="#0a0807" stop-opacity="0.35"></stop>
        <stop offset="100%" stop-color="#000" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="faceUL" x1="140" y1="80" x2="260" y2="280" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#2a2420"></stop>
        <stop offset="100%" stop-color="#0c0a09"></stop>
      </linearGradient>
      <linearGradient id="faceUR" x1="380" y1="60" x2="260" y2="280" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#3a322c"></stop>
        <stop offset="100%" stop-color="#14110f"></stop>
      </linearGradient>
      <linearGradient id="faceLL" x1="160" y1="500" x2="260" y2="280" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#a45a3c"></stop>
        <stop offset="45%" stop-color="#5a2e22"></stop>
        <stop offset="100%" stop-color="#1a100c"></stop>
      </linearGradient>
      <linearGradient id="faceLR" x1="360" y1="540" x2="260" y2="260" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#d48962"></stop>
        <stop offset="38%" stop-color="#8a4a32"></stop>
        <stop offset="100%" stop-color="#221612"></stop>
      </linearGradient>
      <linearGradient id="innerWall" x1="200" y1="330" x2="320" y2="180" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#c07852"></stop>
        <stop offset="100%" stop-color="#3a241c"></stop>
      </linearGradient>
      <linearGradient id="edge" x1="260" y1="40" x2="260" y2="560" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#6a5e54" stop-opacity="0.35"></stop>
        <stop offset="70%" stop-color="#e0a07a" stop-opacity="0.85"></stop>
        <stop offset="100%" stop-color="#ffc8a0" stop-opacity="1"></stop>
      </linearGradient>
      <linearGradient id="reflectFade" x1="0" y1="568" x2="0" y2="640" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#fff" stop-opacity="0.28"></stop>
        <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <filter id="glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="18" result="b"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
      <filter id="soft">
        <feGaussianBlur stdDeviation="22"></feGaussianBlur>
      </filter>
      <mask id="reflectMask">
        <rect x="0" y="568" width="520" height="72" fill="url(#reflectFade)"></rect>
      </mask>
    </defs>

    <ellipse cx="260" cy="568" rx="240" ry="58" fill="url(#ground)"></ellipse>
    <ellipse class="shard-pulse" cx="260" cy="560" rx="170" ry="36" fill="url(#underglow)" filter="url(#soft)"
    ></ellipse>
    <ellipse cx="260" cy="558" rx="70" ry="10" fill="#f0b090" opacity="0.55" filter="url(#glow)"></ellipse>

    {
      Array.from({ length: 14 }, (_, i) => {
        const t = (i - 6.5) / 6.5;
        const y = 530 + Math.abs(t) * 18;
        const half = 210 - Math.abs(t) * 70;
        return (
          <line
            x1={260 - half}
            y1={y}
            x2={260 + half}
            y2={y}
            stroke="#c4785a"
            stroke-opacity={0.045 + (1 - Math.abs(t)) * 0.06}
          />
        );
      })
    }

    {particles.map((p) => (
      <circle
        cx={p.x}
        cy={p.y}
        r={p.r}
        fill={p.copper ? '#d49274' : '#f4efe6'}
        opacity={p.o}
      />
    ))}

    <g mask="url(#reflectMask)" opacity="0.35" transform="translate(0 1120) scale(1 -1)">
      <path d="M260 42 L96 248 L260 248 Z" fill="#2a201c"></path>
      <path d="M260 42 L424 248 L260 248 Z" fill="#3a2c26"></path>
      <path d="M96 248 L260 558 L260 248 Z" fill="#8a4a32"></path>
      <path d="M424 248 L260 558 L260 248 Z" fill="#c07852"></path>
    </g>

    <g class="shard-body">
      <path d="M260 42 L96 248 L200 248 L260 172 Z" fill="url(#faceUL)"></path>
      <path d="M260 42 L424 248 L320 248 L260 172 Z" fill="url(#faceUR)"></path>
      <path d="M96 248 L260 558 L260 338 L200 248 Z" fill="url(#faceLL)"></path>
      <path d="M424 248 L260 558 L260 338 L320 248 Z" fill="url(#faceLR)"></path>

      <path d="M260 172 L200 248 L260 188 L320 248 Z" fill="url(#innerWall)" opacity="0.55"></path>
      <path d="M200 248 L260 338 L248 250 Z" fill="#6a3828" opacity="0.7"></path>
      <path d="M320 248 L260 338 L272 250 Z" fill="#e09a74" opacity="0.45"></path>

      <path
        d="M260 42 L96 248 L260 558 L424 248 Z"
        stroke="url(#edge)"
        stroke-width="1.1"
        opacity="0.55"
      ></path>
      <path
        d="M260 172 L320 248 L260 338 L200 248 Z"
        stroke="#e8b090"
        stroke-width="1"
        opacity="0.4"
      ></path>
      <path d="M260 42 L260 172" stroke="#d8c8bc" stroke-width="0.7" opacity="0.28"></path>
      <path d="M260 338 L260 558" stroke="#ffd0b0" stroke-width="1.1" opacity="0.55"></path>
    </g>
  </svg>
</div>
