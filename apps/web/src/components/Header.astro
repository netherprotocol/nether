---
import { withBase } from '../lib/site';

const homeHref = withBase();
const docsHref = withBase('docs');
---

<header class="grid grid-cols-3 items-center px-6 py-5 md:px-10">
  <a href={homeHref} class="font-display text-xl text-white md:text-2xl">Nether</a>
  <nav class="justify-self-center" aria-label="Primary">
    <a
      href={docsHref}
      class="text-[0.7rem] font-normal tracking-[0.22em] text-white uppercase"
    >
      Documentation
    </a>
  </nav>
  <div aria-hidden="true"></div>
</header>
