---
interface Props {
  name: 'grave' | 'reckoning' | 'reaper' | 'end';
}

const { name } = Astro.props;
---

<svg
  class="h-7 w-7 text-accent"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'grave' && (
      <>
        <path d="M4 20h16" />
        <path d="M6 20V10l6-6 6 6v10" />
        <path d="M10 20v-5h4v5" />
      </>
    )
  }
  {
    name === 'reckoning' && (
      <>
        <path d="M12 3 19 12 12 21 5 12Z" />
        <path d="M5 12h14" />
      </>
    )
  }
  {
    name === 'reaper' && (
      <>
        <path d="M8 11.2c0-2.8 1.6-5.7 4-6.7 2.4 1 4 3.9 4 6.7 0 1.5-.8 2.6-2 3.1" />
        <path d="M10.2 10.6c.25 1.2 1 1.9 1.8 1.9s1.55-.7 1.8-1.9" />
        <path d="M9.2 20c.5-3 1.8-4.6 2.8-4.6s2.3 1.6 2.8 4.6" />
        <path d="M15.4 8.4c2.3.5 4.4 1.7 6.1 3.4" />
        <path d="M16.2 7.2 15.6 13" />
      </>
    )
  }
  {
    name === 'end' && (
      <>
        <path d="M4 17h16" />
        <path d="M7 17c0-3.2 2.2-8 5-10 2.8 2 5 6.8 5 10" />
        <path d="M9.5 17c.4-2 1.4-4.2 2.5-5.2 1.1 1 2.1 3.2 2.5 5.2" />
      </>
    )
  }
</svg>
