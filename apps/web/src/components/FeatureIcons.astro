---
interface Props {
  name: 'grave' | 'reaper' | 'lock' | 'silence';
}

const { name } = Astro.props;
---

<svg
  class="h-7 w-7 text-accent"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'grave' && (
      <>
        <path d="M4 20h16" />
        <path d="M6 20V10l6-6 6 6v10" />
        <path d="M10 20v-5h4v5" />
      </>
    )
  }
  {
    name === 'reaper' && (
      <>
        <path d="M9 10c0-2.2 1.8-4.5 3-5.5 1.2 1 3 3.3 3 5.5 0 1.8-1.3 3-3 3s-3-1.2-3-3Z" />
        <path d="M8 20c.6-3 2.2-4.5 4-4.5s3.4 1.5 4 4.5" />
        <path d="M12 13.5V16" />
        <path d="M15.5 8.2c2.4.4 4.7 1.6 6.5 3.3" />
        <path d="M20.8 8.8c.2 1.4 0 2.8-.6 4" />
      </>
    )
  }
  {
    name === 'lock' && (
      <>
        <rect x="6" y="11" width="12" height="9" rx="1.2" />
        <path d="M8.5 11V8.2A3.5 3.5 0 0 1 15.5 8.2V11" />
        <path d="M12 14.5v2.2" />
      </>
    )
  }
  {
    name === 'silence' && (
      <>
        <path d="M5 7.5h10a2 2 0 0 1 2 2V15a2 2 0 0 1-2 2H9l-4 3v-3.2A2 2 0 0 1 3 14.8V9.5a2 2 0 0 1 2-2Z" />
        <path d="M8 11h6" />
        <path d="M8 14h3.5" />
      </>
    )
  }
</svg>
