---
import ArrowRight from '@lucide/astro/icons/arrow-right';

interface Props {
  steps: readonly string[];
  label: string;
}

const { steps, label } = Astro.props;
---

<div class="learn-flow" role="img" aria-label={label}>
  {
    steps.map((step, index) => (
      <>
        {index > 0 ? (
          <ArrowRight class="learn-flow-arrow" stroke-width={1.5} aria-hidden="true" />
        ) : null}
        <span class="learn-chip">{step}</span>
      </>
    ))
  }
</div>
