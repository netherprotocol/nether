---
import ChevronDown from '@lucide/astro/icons/chevron-down';

interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="learn-faq-item">
  <summary>
    <span>{question}</span>
    <ChevronDown class="learn-faq-chevron" stroke-width={1.5} aria-hidden="true" />
  </summary>
  <div class="learn-faq-panel">
    <slot />
  </div>
</details>
